# Hosted and self-hosted run the same application.
# Point this hostname at the server before starting the public Compose stack.
ADC_PUBLIC_URL=https://devices.example.com
# Generate independently: openssl rand -hex 48 / openssl rand -hex 32
ADC_AUTH_SECRET=
ADC_DATABASE_PASSWORD=
# For pnpm dev, set a reachable PostgreSQL database and use http://localhost:8787.
DATABASE_URL=postgresql://adc:replace-with-a-strong-database-password@127.0.0.1:5432/adc
ADC_REGISTRATION_ENABLED=true
ADC_REQUIRE_EMAIL_VERIFICATION=true
# Password reset and verification use this transport. URL-encode SMTP credentials.
ADC_SMTP_URL=
ADC_SMTP_FROM=Agent Device Cloud <no-reply@devices.example.com>
# Enables registration of OAuth/PKCE MCP clients. User consent is still required.
ADC_OAUTH_DYNAMIC_REGISTRATION=true
# Optional GitHub OAuth App. Callback: <ADC_PUBLIC_URL>/api/auth/callback/github
# Both values are server-only; keep the secret out of frontend/VITE variables.
ADC_GITHUB_CLIENT_ID=
ADC_GITHUB_CLIENT_SECRET=
# Official hosted deployments may opt into privacy-focused Plausible analytics.
# Leave both empty for self-hosted installations; no analytics script is then injected.
ADC_ANALYTICS_SCRIPT_URL=
ADC_ANALYTICS_DOMAIN=
# Optional static/CDN/GitHub release directory containing install.sh and client archives.
# Leave empty to serve built dist/node files from this Control Plane.
ADC_NODE_DOWNLOAD_URL=
# Signed Android release directory. Local runs default to dist/android.
ADC_ANDROID_RELEASE_DIR=
# Compose-only host directory mounted read-only into the Control Plane container.
ADC_ANDROID_RELEASE_HOST_DIR=./android-releases
# Persistent content-addressed image storage. Required for Android screen.capture.
ADC_ASSET_DIR=./data/assets
# Persistent local relay storage for in-flight native Node-to-Node transfer chunks.
ADC_TRANSFER_DIR=./data/transfers
# Maximum declared size of one native transfer in bytes (default 100 GiB).
ADC_TRANSFER_MAX_BYTES=107374182400
# Optional cross-origin API access for browser consumers such as harness plugins.
# Comma-separated exact origins (https://host[:port]) or * for any. Empty keeps
# API access same-origin; browser sessions are never sent cross-origin.
ADC_CORS_ORIGINS=
# Only used by the loopback Compose override.
ADC_HTTP_PORT=8088
